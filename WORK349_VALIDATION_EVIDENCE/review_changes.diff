+T _enumByName<T extends Enum>(List<T> values, Object? raw, T fallback) {
+  final String? name = raw as String?;
+  if (name == null) return fallback;
+  for (final T value in values) {
+    if (value.name == name) return value;
+  }
+  return fallback;
+}
