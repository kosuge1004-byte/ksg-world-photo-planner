+    referenceStarCount: referenceStars.length,
+    finalStarCount: finalStars.length,
+    referenceMeasuredStarCount: referenceStars
+        .where((DetectedStar star) =>
+            star.psfFwhmPx != null &&
+            star.psfFwhmPx!.isFinite &&
+            star.psfFwhmPx! > 0)
+        .length,
