-/// Diagnostic-only robust high-frequency proxy.
-///
-/// This intentionally does NOT return a pass/fail verdict: a lower
-/// high-frequency residual can mean genuine random-noise reduction, but it can
-/// also mean blur. Registration RMS/PSF diagnostics must be interpreted
-/// alongside it. Samples are bounded so the diagnostic does not create another
-/// full-frame allocation.
-Future<double> _estimateHighFrequencyMadProxy(
-  LinearRgbTileStore store,
-) async {
-  const int maxRows = 192;
-  const int maxSamples = 120000;
-  final int rowStride =
-      store.height <= maxRows ? 1 : (store.height / maxRows).ceil();
-  final int columnStride = math.max(
-    1,
-    ((store.width * math.max(1, (store.height / rowStride).ceil())) /
-            maxSamples)
-        .ceil(),
-  ).toInt();
-  final List<double> residuals = <double>[];
-  for (int y = 0; y < store.height; y += rowStride) {
-    final LinearRgbTile row = await store.readRegion(
-      x: 0,
-      y: y,
-      width: store.width,
-      height: 1,
-    );
-    final data = row.interleavedRgb;
-    for (int x = 1; x < store.width - 1; x += columnStride) {
-      final double left = data[(x - 1) * 3 + 1];
-      final double center = data[x * 3 + 1];
-      final double right = data[(x + 1) * 3 + 1];
-      // Second difference suppresses smooth gradients better than the former
-      // adjacent-pixel RMS while remaining sensitive to high-frequency noise.
-      residuals.add((left - 2 * center + right).abs());
-      if (residuals.length >= maxSamples) break;
-    }
-    if (residuals.length >= maxSamples) break;
-  }
-  if (residuals.isEmpty) return 0;
-  final double medianAbsResidual = _medianOfSorted(residuals);
-  // For Gaussian white noise, the second-difference standard deviation is
-  // sqrt(6)*sigma. 1.4826 converts MAD-like absolute residual scale to sigma.
-  return 1.4826 * medianAbsResidual / math.sqrt(6);
-}
