+            } on Object {
+              // Continue releasing the remaining stores after cleanup failure.
+            }
+            if (referenceProcessingStore != referenceDecoded.store) {
+              await referenceProcessingStore.dispose();
+            }
+            await referenceDecoded.store.dispose();
+          }
