+    final double? referenceFwhm = reference.psfFwhmPx;
+    final double? finalFwhm = finalStar.psfFwhmPx;
+    if (referenceFwhm == null ||
+        finalFwhm == null ||
+        !referenceFwhm.isFinite ||
+        !finalFwhm.isFinite ||
+        referenceFwhm <= 0 ||
+        finalFwhm <= 0) {
