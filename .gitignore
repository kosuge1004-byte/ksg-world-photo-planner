# Machine-specific, generated by `flutter create` / IDE tooling; a fresh
# checkout regenerates these on first `flutter pub get` / first Gradle sync.
# Never commit real paths from a specific developer's machine (finding: a
# prior zip export shipped android/local.properties with a Windows
# developer's absolute SDK paths, and .flutter-plugins-dependencies with
# that same machine's pub cache paths).
android/local.properties
android/**/GeneratedPluginRegistrant.java
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*

# Release signing credentials — never commit a real keystore or its
# passwords. See the signing-config comment in android/app/build.gradle.kts.
android/app/key.properties
android/**/*.keystore
android/**/*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
