{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-stack.invalid/schema/tiff-raw-probe-v1.json",
  "title": "Mobile Stack TIFF RAW sample probe result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "format",
    "byteLength",
    "sha256",
    "container",
    "ifdsVisited",
    "candidatesFound",
    "preview"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "ok"
    },
    "format": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,16}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 16
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "byteOrder"],
      "properties": {
        "kind": {
          "const": "classic-tiff"
        },
        "byteOrder": {
          "enum": ["little-endian", "big-endian"]
        }
      }
    },
    "ifdsVisited": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "candidatesFound": {
      "type": "integer",
      "minimum": 0
    },
    "preview": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/preview"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDimension": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "ifdOffset",
        "offset",
        "byteLength",
        "width",
        "height",
        "sha256"
      ],
      "properties": {
        "source": {
          "enum": ["jpeg-interchange", "jpeg-strip"]
        },
        "ifdOffset": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "byteLength": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8388608
        },
        "width": {
          "$ref": "#/$defs/nullableDimension"
        },
        "height": {
          "$ref": "#/$defs/nullableDimension"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
