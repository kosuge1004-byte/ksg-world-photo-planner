{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-stack.invalid/schema/arw-lossless-reference-v2.json",
  "title": "Mobile Stack Sony ARW lossless reference decode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "format",
    "decoder",
    "byteLength",
    "width",
    "height",
    "bitsPerSample",
    "cfaPattern",
    "orientation",
    "activeArea",
    "blackLevels",
    "sonyWbRggbLevels",
    "cameraWhiteBalance",
    "whiteLevel",
    "tileWidth",
    "tileHeight",
    "tileCount",
    "minimum",
    "maximum",
    "samplePoints",
    "uint16LittleEndianSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "const": "ok"
    },
    "format": {
      "const": "ARW"
    },
    "decoder": {
      "const": "jpeg-lossless-sof3-predictor1"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 16
    },
    "width": {
      "type": "integer",
      "minimum": 2
    },
    "height": {
      "type": "integer",
      "minimum": 2
    },
    "bitsPerSample": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16
    },
    "cfaPattern": {
      "const": "RGGB"
    },
    "orientation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "activeArea": {
      "$ref": "#/$defs/rectangle"
    },
    "blackLevels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65534
      }
    },
    "sonyWbRggbLevels": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cameraWhiteBalance": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "whiteLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "tileWidth": {
      "type": "integer",
      "minimum": 2
    },
    "tileHeight": {
      "type": "integer",
      "minimum": 2
    },
    "tileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "minimum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "maximum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "samplePoints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/samplePoint"
      }
    },
    "uint16LittleEndianSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "samplePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "value"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
