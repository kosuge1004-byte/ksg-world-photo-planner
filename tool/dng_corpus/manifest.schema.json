{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-stack.invalid/schema/dng-corpus-v1.json",
  "title": "Mobile Stack DNG verification corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "samples"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "corpusId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "sha256",
        "byteLength",
        "provenance",
        "reference",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 8
        },
        "floatTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "redistributable"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "redistributable": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command", "recordedAt"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "activeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fourNonnegativeNumbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "fourPositiveNumbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "cfa",
        "activeArea",
        "orientation",
        "blackLevels",
        "whiteLevel",
        "cameraWhiteBalance"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "cfa": {
          "enum": ["RGGB", "BGGR", "GRBG", "GBRG"]
        },
        "activeArea": {
          "$ref": "#/$defs/activeArea"
        },
        "orientation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "blackLevels": {
          "$ref": "#/$defs/fourNonnegativeNumbers"
        },
        "whiteLevel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cameraWhiteBalance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fourPositiveNumbers"
            }
          ]
        }
      }
    }
  }
}
