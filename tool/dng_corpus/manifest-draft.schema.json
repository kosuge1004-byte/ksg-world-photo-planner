{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-stack.invalid/schema/dng-corpus-manifest-draft-v1.json",
  "title": "Mobile Stack incomplete DNG corpus manifest draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftType",
    "draftVersion",
    "status",
    "corpusId",
    "inventorySha256",
    "generatedAt",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "draftType": {
      "const": "mobile-stack-dng-corpus-manifest-draft"
    },
    "draftVersion": {
      "const": 1
    },
    "status": {
      "const": "incomplete"
    },
    "corpusId": {
      "$ref": "#/$defs/identifier"
    },
    "inventorySha256": {
      "$ref": "#/$defs/sha256"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "sha256",
        "byteLength",
        "floatTolerance",
        "provenance",
        "reference",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "floatTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance"
            }
          ]
        },
        "reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "expected": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expected"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "redistributable"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "redistributable": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command", "recordedAt"],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "activeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fourNonnegativeNumbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "fourPositiveNumbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "cfa",
        "activeArea",
        "orientation",
        "blackLevels",
        "whiteLevel",
        "cameraWhiteBalance"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "cfa": {
          "enum": ["RGGB", "BGGR", "GRBG", "GBRG"]
        },
        "activeArea": {
          "$ref": "#/$defs/activeArea"
        },
        "orientation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "blackLevels": {
          "$ref": "#/$defs/fourNonnegativeNumbers"
        },
        "whiteLevel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cameraWhiteBalance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fourPositiveNumbers"
            }
          ]
        }
      }
    }
  }
}
