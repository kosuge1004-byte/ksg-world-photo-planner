{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-spot-search-consumer",
  "main": "./workers/spot-search-consumer.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    }
  ],
  // Pages Functions側のNETWORK_CACHEと同じR2バケットをここにも束縛すると、
  // DEMタイルキャッシュ（空判定含む）を対話的な三脚候補探索とバックグラウンドの
  // スポット検索ジョブの両方で共有できる。未設定のままでも従来どおり動作する
  // （persistentCacheFromR2がundefinedを安全に許容するため、キャッシュへの
  // 保存だけがスキップされ、通信自体はそのまま成功する）。
  //
  // R2の有効化にはCloudflareアカウントへの支払い方法登録が必要（無料枠内でも
  // 登録自体は必須）なため、2026-08-23にカード登録なしで運用する方針へ戻した。
  // 将来カード登録済みでR2を使いたくなったら、以下のコメントを外して
  // bucket_nameを実際に作成したR2バケット名に置き換えるだけでよい。
  // "r2_buckets": [
  //   {
  //     "binding": "NETWORK_CACHE",
  //     "bucket_name": "ここに実際のR2バケット名"
  //   }
  // ],
  "queues": {
    "consumers": [
      {
        "queue": "astrosight-spot-search",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
