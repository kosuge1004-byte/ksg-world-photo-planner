{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-spot-search-consumer",
  "main": "./workers/spot-search-consumer.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    }
  ],
  // Pages Functions側のNETWORK_CACHEと同じR2バケットをここにも束縛し、
  // DEMタイルキャッシュ（空判定含む）を対話的な三脚候補探索とバックグラウンドの
  // スポット検索ジョブの両方で共有する。R2は有効なまま維持し、すべての
  // 読み書きにR2_WRITE_BUDGET_DBの無料枠ガードを適用する。
  "r2_buckets": [
    {
      "binding": "NETWORK_CACHE",
      "bucket_name": "astrosight-network-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "R2_WRITE_BUDGET_DB",
      "database_name": "astrosight-r2-write-budget",
      "database_id": "a679879f-6411-437e-b7f2-1a161fce8237"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "astrosight-spot-search",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
