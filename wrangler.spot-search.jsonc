{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-spot-search-consumer",
  "main": "./workers/spot-search-consumer.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c3bd81d48489ef4fdd25b1b9a58"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "astrosight-spot-search",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  }
}
