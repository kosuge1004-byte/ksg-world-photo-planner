{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-spot-search-consumer",
  "main": "./workers/spot-search-consumer.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    }
  ],
  // Pages Functions側のNETWORK_CACHE（PHASE5_4_CLOUDFLARE_R2_CACHE.md参照）と
  // 同じR2バケットをここにも束縛すると、DEMタイルキャッシュ（空判定含む）を
  // 対話的な三脚候補探索とバックグラウンドのスポット検索ジョブの両方で
  // 共有できる。未設定のままでも従来どおり動作する（persistentCacheFromR2が
  // undefinedを安全に許容するため、キャッシュへの保存だけがスキップされ、
  // 通信自体はそのまま成功する）。
  //
  // 後でキャッシュの効果を得たくなったら、以下のコメントを外して
  // bucket_nameを実際に作成したR2バケット名に置き換えるだけでよい。
  // "r2_buckets": [
  //   {
  //     "binding": "NETWORK_CACHE",
  //     "bucket_name": "ここに実際のR2バケット名"
  //   }
  // ],
  "queues": {
    "consumers": [
      {
        "queue": "astrosight-spot-search",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
