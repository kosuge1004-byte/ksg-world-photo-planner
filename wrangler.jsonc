{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Pagesプロジェクト本体の設定。CLOUDFLARE_DEPLOYMENT.md参照。
  // 先読み（landmark prewarm）用Cron Workerは別ファイル
  // （wrangler.prewarm.jsonc）で管理しており、こちらとは別デプロイ対象。
  "name": "astrosight",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    },
    // 2026-09-08追記: 三脚候補周辺データダウンロードのサーバー側バックグラウンド
    // ジョブ用。SPOT_SEARCH_JOBSとは別ネームスペースにして、既存のスポット検索
    // ジョブの空き容量・書き込み予算に一切影響を与えないようにする。
    // 手順: README_BEARING_PROFILE_DOWNLOAD_JOB_SETUP.md を参照。
    {
      "binding": "BEARING_PROFILE_DOWNLOAD_JOBS",
      "id": "2fb4bcb1132140a6bfbfd73ddab4a9f0"
    }
  ],
  // 地形標高（GSI DEMタイル）等の共有キャッシュ。R2は有効なまま維持し、
  // server/r2SafetyBudget.tsの無料枠ガードを全経路に適用する。
  "r2_buckets": [
    {
      "binding": "NETWORK_CACHE",
      "bucket_name": "astrosight-network-cache"
    }
  ],
  // R2の容量・月間読み取り・月間書き込みを共有集計するD1。
  "d1_databases": [
    {
      "binding": "R2_WRITE_BUDGET_DB",
      "database_name": "astrosight-r2-write-budget",
      "database_id": "a679879f-6411-437e-b7f2-1a161fce8237"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SPOT_SEARCH_QUEUE",
        "queue": "astrosight-spot-search"
      },
      {
        "binding": "BEARING_PROFILE_DOWNLOAD_QUEUE",
        "queue": "astrosight-bearing-profile-download"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
