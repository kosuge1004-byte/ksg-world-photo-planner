{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-prewarm-landmark-cron",
  "main": "./workers/prewarm-landmark-cron.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "NETWORK_CACHE",
      "bucket_name": "astrosight-network-cache"
    }
  ],
  // R2利用予算（月間書き込み/読み取り上限・保存容量上限）を数えるための
  // 共有カウンターKV。Pages Functions側・spot-search consumer側と同じ
  // namespaceを指す必要がある（IDが食い違うと予算が別々に管理されてしまう）。
  "kv_namespaces": [
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    }
  ],
  // 毎日 UTC 18:00（日本時間 翌3:00、深夜・利用の少ない時間帯）に1回実行。
  // 1回あたりserver/prewarmLandmarkCore.tsのCHUNK_SIZE件だけ処理し、
  // 日をまたいでランドマーク全件を自動的に巡回する。
  // 頻度・時間帯を変更したい場合はcron式を書き換える
  // （https://developers.cloudflare.com/workers/configuration/cron-triggers/）。
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
