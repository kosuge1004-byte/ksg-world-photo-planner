{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astrosight-bearing-profile-download-consumer",
  "main": "./workers/bearing-profile-download-consumer.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "BEARING_PROFILE_DOWNLOAD_JOBS",
      "id": "2fb4bcb1132140a6bfbfd73ddab4a9f0"
    },
    {
      "binding": "SPOT_SEARCH_JOBS",
      "id": "92197c38d81d48489ef4fdd25b1b9a58"
    }
  ],
  // ライブ三脚探索・スポット検索と同じR2 DEMタイルキャッシュを共有する。
  // R2は有効なまま維持し、R2_WRITE_BUDGET_DBの無料枠ガードを適用する。
  "r2_buckets": [
    {
      "binding": "NETWORK_CACHE",
      "bucket_name": "astrosight-network-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "R2_WRITE_BUDGET_DB",
      "database_name": "astrosight-r2-write-budget",
      "database_id": "a679879f-6411-437e-b7f2-1a161fce8237"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "astrosight-bearing-profile-download",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
