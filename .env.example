# Public browser token. Restrict it to the AstroSight origins in Cesium ion.
VITE_CESIUM_ION_TOKEN=

# Server-side secrets. Set these in Cloudflare, never in this file.
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# Optional E-drive DEM origin. The feature remains disabled unless all four
# values are present. Store the three credentials as Cloudflare secrets.
LOCAL_DEM_API_URL=
LOCAL_DEM_ORIGIN_TOKEN=
LOCAL_DEM_ACCESS_CLIENT_ID=
LOCAL_DEM_ACCESS_CLIENT_SECRET=

# Local Windows DEM service only. Keep these in the process environment or a
# protected local file outside the repository and release ZIP.
LOCAL_DEM_DATA_ROOT=
