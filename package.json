{
  "name": "astrosight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-cloudflare-geo-tz-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:regression",
    "test:regression": "node scripts/run-regression-tests.mjs",
    "preview": "vite preview",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "verify:android": "node scripts/verify-android-native.mjs",
    "verify:focal-length-input": "node scripts/verify-focal-length-input.mjs",
    "verify:google-maps-url": "node scripts/verify-google-maps-url.mjs",
    "verify:google-maps-url:live": "node scripts/verify-google-maps-url-live.mjs",
    "verify:geodesic": "node scripts/verify-geodesic-comparison.mjs",
    "verify:geodesic:reference": "python scripts/verify-geodesic-reference-python.py",
    "verify:geodesic:direct": "node scripts/verify-geodesic-direct.mjs",
    "verify:view-correction": "node scripts/verify-view-correction.mjs",
    "verify:frame-boundaries": "node scripts/verify-frame-boundaries.mjs",
    "verify:cache-keys": "node scripts/verify-cache-keys.mjs",
    "verify:search-generation": "node scripts/verify-search-generation.mjs",
    "verify:occlusion-state": "node scripts/verify-occlusion-state.mjs",
    "verify:search-progress": "node scripts/verify-search-progress.mjs",
    "verify:performance-lifecycle": "node scripts/verify-performance-lifecycle.mjs",
    "verify:user-error-handling": "node scripts/verify-user-error-handling.mjs",
    "verify:precision-descriptions": "node scripts/verify-precision-descriptions.mjs",
    "verify:occlusion-reasons": "node scripts/verify-occlusion-reasons.mjs",
    "verify:platform-compatibility": "node scripts/verify-platform-compatibility.mjs",
    "verify:final-cleanup": "node scripts/verify-final-cleanup.mjs",
    "verify:search-engine-exclusion": "node scripts/verify-search-engine-exclusion.mjs",
    "verify:pwa-installability": "node scripts/verify-pwa-installability.mjs",
    "verify:celestial-occlusion-stability": "node scripts/verify-celestial-occlusion-stability.mjs",
    "verify:cloudflare": "node scripts/verify-cloudflare-migration.mjs",
    "cf:pages:dev": "npm run build && wrangler pages dev dist",
    "cf:pages:deploy": "npm run build && wrangler pages deploy dist",
    "cf:consumer:dev": "wrangler dev --config wrangler.spot-search.jsonc",
    "cf:consumer:deploy": "wrangler deploy --config wrangler.spot-search.jsonc",
    "verify:workers-kv-writes": "node scripts/verify-workers-kv-writes.mjs",
    "verify:person-display": "node scripts/verify-person-display.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "^1.143.0",
    "geo-tz": "^8.1.8",
    "geobuf": "^3.0.2",
    "geographiclib-geodesic": "^2.2.0",
    "pbf": "^3.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/geobuf": "^3.0.4",
    "@types/node": "^24.13.2",
    "@types/pbf": "^3.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-cesium": "^1.2.23",
    "wrangler": "^4.118.0"
  }
}
